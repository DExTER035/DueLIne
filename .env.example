# =========================================================================
# DueLine — Environment Configuration Template
# Stage 2B: Supabase Authentication & Browser Integration
# =========================================================================

# Supabase Public Configuration (Safe for client-side browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# =========================================================================
# Supabase Dashboard Auth URL Configuration:
# When configuring your Supabase project (Authentication -> URL Configuration):
#
# 1. Site URL:
#    Local Development: http://localhost:3000
#    Production:        https://dueline.pages.dev (or custom domain)
#
# 2. Redirect URLs (Allow list for PKCE authorization callback):
#    - http://localhost:3000/auth/callback
#    - http://localhost:3000/reset-password
#    - https://dueline.pages.dev/auth/callback
#    - https://dueline.pages.dev/reset-password
# =========================================================================

# IMPORTANT SECURITY NOTICE:
# Never include or expose SUPABASE_SERVICE_ROLE_KEY in client-side code,
# public repositories, or environment variable files sent to the browser.

